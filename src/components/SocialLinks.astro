---
// Icon links to the company's social profiles. Only profiles with a URL in
// settings.json are shown. Each opens in a new tab with a screen-reader note.
import settings from "../data/settings.json";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

interface Props {
  class?: string;
  /** Icon size in Tailwind units, e.g. "w-6 h-6". */
  size?: string;
}
const { class: className = "", size = "w-6 h-6" } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const social = settings.social as Record<string, string>;
const icons: Record<string, { label: string; path: string }> = {
  facebook: {
    label: "Facebook",
    path: "M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.45 2.89h-2.33v6.99A10 10 0 0 0 22 12Z",
  },
  instagram: {
    label: "Instagram",
    path: "M12 2.16c3.2 0 3.58.01 4.85.07 3.25.15 4.77 1.69 4.92 4.92.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.15 3.23-1.66 4.77-4.92 4.92-1.27.06-1.64.07-4.85.07s-3.58-.01-4.85-.07c-3.26-.15-4.77-1.7-4.92-4.92C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85C2.38 3.92 3.9 2.38 7.15 2.23 8.42 2.17 8.8 2.16 12 2.16ZM12 0C8.74 0 8.33.01 7.05.07 2.7.27.27 2.69.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.2 4.36 2.62 6.78 6.98 6.98C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c4.35-.2 6.78-2.62 6.98-6.98.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.2-4.35-2.62-6.78-6.98-6.98C15.67.01 15.26 0 12 0Zm0 5.84A6.16 6.16 0 1 0 12 18.16 6.16 6.16 0 0 0 12 5.84ZM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm6.4-11.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88Z",
  },
  linkedin: {
    label: "LinkedIn",
    path: "M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z",
  },
  tripadvisor: {
    label: "Tripadvisor",
    path: "M12 5.5c2.6 0 5 .7 7 1.9h3.9l-1.7 1.9A7.1 7.1 0 1 1 12 19.4 7.1 7.1 0 1 1 2.8 9.3L1.1 7.4H5c2-1.2 4.4-1.9 7-1.9Zm-5.1 4.8a3.9 3.9 0 1 0 0 7.8 3.9 3.9 0 0 0 0-7.8Zm10.2 0a3.9 3.9 0 1 0 0 7.8 3.9 3.9 0 0 0 0-7.8Zm-10.2 2a1.9 1.9 0 1 1 0 3.8 1.9 1.9 0 0 1 0-3.8Zm10.2 0a1.9 1.9 0 1 1 0 3.8 1.9 1.9 0 0 1 0-3.8ZM12 7a9.6 9.6 0 0 0-4.2 1 5.8 5.8 0 0 1 4.2 3.3A5.8 5.8 0 0 1 16.2 8 9.6 9.6 0 0 0 12 7Z",
  },
  youtube: {
    label: "YouTube",
    path: "M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.2 3.6-6.2 3.6Z",
  },
};
const links = Object.entries(icons)
  .filter(([key]) => social[key])
  .map(([key, icon]) => ({ ...icon, url: social[key] }));
---

{
  links.length > 0 && (
    <ul class={`flex items-center gap-4 ${className}`}>
      {links.map((link) => (
        <li>
          <a
            href={link.url}
            target="_blank"
            rel="noopener"
            class="inline-flex p-1.5 hover:opacity-70 transition-opacity"
          >
            <svg aria-hidden="true" viewBox="0 0 24 24" class={`${size} fill-current`}>
              <path d={link.path} />
            </svg>
            <span class="sr-only">
              {link.label} {t("footer.newTab")}
            </span>
          </a>
        </li>
      ))}
    </ul>
  )
}
