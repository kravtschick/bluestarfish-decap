---
// Address, phone, email, legal details and map. Shown under the form on the
// contact page and in the "Where to find us" section of the About page.
import settings from "../data/settings.json";
import SocialLinks from "./SocialLinks.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const info = settings.info;
const phoneHref = `tel:${info.phone.replace(/\s+/g, "")}`;
---

<section class="mt-24 lg:mt-32" aria-labelledby="visit-heading">
  <h2 id="visit-heading" class="text-3xl font-semibold text-center">{t("about.visit")}</h2>
  <div class="mt-12 grid gap-8 lg:grid-cols-5 items-start">
    <address class="not-italic lg:col-span-2 flex flex-col gap-4 text-base">
      <p class="font-semibold text-lg">{info.name}</p>
      <p>{info.address}<br />{info.city}</p>
      <p>
        <a href={phoneHref} class="underline underline-offset-4 hover:text-rose-600">{info.phone}</a>
        <br />
        <a href={`mailto:${info.email}`} class="underline underline-offset-4 hover:text-rose-600">{info.email}</a>
      </p>
      <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm text-gray-700">
        <dt>{t("about.founded")}</dt><dd>{info.founded}</dd>
        <dt>{t("about.taxId")}</dt><dd>{info.tax_id}</dd>
      </dl>
      {
        info.google_business && (
          <p>
            <a
              href={info.google_business}
              target="_blank"
              rel="noopener"
              class="inline-block border border-gray-950 px-4 py-2 rounded-lg hover:bg-gray-100"
            >
              {t("about.openMap")}<span class="sr-only"> {t("footer.newTab")}</span>
            </a>
          </p>
        )
      }
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wide text-gray-700 mb-2">{t("about.social")}</h3>
        <SocialLinks />
      </div>
    </address>
    <div class="lg:col-span-3 rounded-xl overflow-hidden shadow-lg bg-gray-100 aspect-[4/3]">
      <iframe
        src={info.map_embed}
        title={`${t("about.visit")}: ${info.short_name}`}
        width="100%"
        height="100%"
        style="border:0"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      ></iframe>
    </div>
  </div>
</section>
