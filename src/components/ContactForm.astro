---
// Contact form sent through EmailJS. Plain HTML plus a small script, so the
// contact page no longer needs React.
import { getLangFromUrl, useTranslations } from "../i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const inputClass =
  "w-full min-w-0 appearance-none border-[1px] border-gray-200 rounded bg-white px-2 py-2 focus:border-gray-400 focus:bg-gray-100 focus:outline-none transition";
---

<div
  data-contact-form
  data-text-button={t("form.button")}
  data-text-sending={t("form.sending")}
>
  <p
    data-status="success"
    role="status"
    hidden
    class="mt-24 lg:mt-32 text-center text-xl w-full max-w-xl mx-auto text-green-700 mb-16 bg-green-100 py-8 px-2 rounded border-[1px] border-green-500"
  >
    {t("form.reply")}
  </p>
  <p
    data-status="error"
    role="alert"
    hidden
    class="mt-24 lg:mt-32 text-center text-xl w-full max-w-xl mx-auto text-red-700 bg-red-200 py-8 px-2 rounded border-[1px] border-red-500"
  >
    {t("form.error")}
  </p>
  <form
    id="contact-form"
    method="post"
    class="flex flex-col mx-auto mt-24 lg:mt-32 gap-1 w-full max-w-xl mb-16"
  >
    <input type="hidden" name="contact_number" />
    <label for="contact-name" class="text-sm">{t("form.name")}</label>
    <input
      id="contact-name"
      type="text"
      name="user_name"
      autocomplete="name"
      required
      placeholder={t("form.name")}
      class={inputClass}
    />
    <label for="contact-email" class="mt-8 text-sm">{t("form.email")}</label>
    <input
      id="contact-email"
      type="email"
      name="user_email"
      autocomplete="email"
      required
      placeholder={t("form.email")}
      class={inputClass}
    />
    <label for="contact-message" class="mt-8 text-sm">{t("form.message")}</label>
    <textarea
      id="contact-message"
      name="message"
      required
      placeholder={t("form.message")}
      class={`${inputClass} h-64`}></textarea>
    <button
      type="submit"
      class="submit-btn bg-rose-600 hover:bg-emerald-700 transition-colors px-4 py-2 rounded-lg text-white w-fit mt-4 cursor-pointer"
    >
      {t("form.button")}
    </button>
  </form>
</div>

<script>
  import emailjs from "@emailjs/browser";

  const SERVICE_ID = "service_j0gcq1f";
  const TEMPLATE_ID = "template_8sqboo9";
  const PUBLIC_KEY = "1BeRlG3ZZaiaQRM0H";

  // Safe to call repeatedly; binds the form once. Runs right away because
  // after a view-transition navigation this module may load after
  // `astro:page-load` has already fired.
  function init() {
    const root = document.querySelector<HTMLElement>("[data-contact-form]");
    const form = root?.querySelector("form");
    if (!root || !form || form.dataset.ready) return;
    form.dataset.ready = "true";

    const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
    const success = root.querySelector<HTMLElement>('[data-status="success"]')!;
    const error = root.querySelector<HTMLElement>('[data-status="error"]')!;

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      error.hidden = true;
      button.disabled = true;
      button.textContent = root.dataset.textSending ?? "";
      try {
        await emailjs.sendForm(SERVICE_ID, TEMPLATE_ID, form, PUBLIC_KEY);
        form.reset();
        form.hidden = true;
        success.hidden = false;
        (window as any).gtag?.("event", "generate_lead", {
          method: "form",
          page_path: location.pathname,
        });
      } catch {
        error.hidden = false;
      } finally {
        button.disabled = false;
        button.textContent = root.dataset.textButton ?? "";
      }
    });
  }

  init();
  document.addEventListener("astro:page-load", init);
</script>
