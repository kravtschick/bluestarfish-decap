---
import { Image } from "astro:assets";
import Wrapper from "./Wrapper.astro";
import logo from "../../public/logo-white.svg";
import Chat from "./Chat.astro";
import SocialLinks from "./SocialLinks.astro";
const pathname = Astro.url.pathname;
const currentYear = new Date().getFullYear();
import chatImg from "../images/chat-white.svg";
import settings from "../data/settings.json";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { isActive, pagePath, type PageKey } from "../i18n/routes";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
// The blog has no pages yet. Add "blog" back here once it does.
const items: PageKey[] = ["about", "countries", "trips", "reviews", "contact"];
const phoneHref = `tel:${settings.info.phone.replace(/\s+/g, "")}`;
---

<footer class="py-12 bg-black text-white mt-16">
  <Wrapper>
    <div class="flex flex-col gap-8">
      <div class="flex justify-between items-center text-sm flex-wrap gap-4">
        <div class="flex flex-col gap-4">
          <Image src={logo} alt={settings.site_title} class="w-24" />
          <SocialLinks size="w-5 h-5" class="-ml-1.5" />
        </div>
        <Chat image={chatImg.src} classes="w-48" />
        <div class="flex gap-8 md:gap-16 flex-wrap">
          <div class="flex flex-col">
            <p class="font-semibold">{settings.info.name}</p>
            <p>{settings.info.address}</p>
            <p>{settings.info.city}</p>
          </div>
          <div class="flex flex-col">
            <p>T. <a href={phoneHref} class="inline-block py-1.5 hover:underline">{settings.info.phone}</a></p>
            <p>
              <a href={`mailto:${settings.info.email}`} class="inline-block py-1.5 hover:underline"
                >{settings.info.email}</a
              >
            </p>
            {
              settings.info.google_business && (
                <p>
                  <a
                    href={settings.info.google_business}
                    target="_blank"
                    rel="noopener"
                    class="inline-flex items-center gap-1.5 py-1.5 hover:underline"
                  >
                    <svg
                      aria-hidden="true"
                      viewBox="0 0 24 24"
                      class="w-4 h-4 fill-current"
                    >
                      <path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z" />
                    </svg>
                    {t("footer.google")}
                    <span class="sr-only">{t("footer.newTab")}</span>
                  </a>
                </p>
              )
            }
          </div>
        </div>
      </div>
      <div
        class="text-xs flex flex-wrap-reverse gap-8 md:gap-0 md:items-center justify-between border-t-[1px] border-t-gray-800 pt-8"
      >
        <div class="flex flex-wrap gap-x-4 gap-y-1">
          <span>&copy; {currentYear} {settings.info.name}</span>
          <a href={pagePath(lang, "privacy")} class="underline underline-offset-2 hover:text-rose-500">{t("nav.privacy")}</a>
        </div>
        <ul class="flex flex-wrap items-center gap-4">
          {
            items.map((key) => (
              <li>
                <a
                  href={pagePath(lang, key)}
                  class={`font-medium tracking-wide drop-shadow-sm ${
                    isActive(pathname, pagePath(lang, key)) ? "text-rose-500" : ""
                  }`}
                >
                  {t(`nav.${key}`)}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Wrapper>
</footer>
