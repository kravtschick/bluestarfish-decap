---
// Sections of the About page below the hero and intro: story and values
// (from the page body), founders, Google reviews, map and social links.
import { getCollection } from "astro:content";
import reviewsData from "../data/reviews.json";
import { Image } from "astro:assets";
import settings from "../data/settings.json";
import ContactDetails from "./ContactDetails.astro";
import teamBoth from "../assets/images/team-both.jpg";
import teamBike from "../assets/images/team-bike.jpg";
import teamDinner from "../assets/images/team-dinner.jpg";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { pagePath } from "../i18n/routes";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang) as (k: string) => string;

const team = (await getCollection("team")).sort(
  (a, b) => a.data.sortOrder - b.data.sortOrder
);
const quotes = reviewsData.reviews
  .filter((r) => r.lang === lang && (r.text as Record<string, string>)[lang]?.length > 150)
  .slice(0, 2)
  .map((r) => ({ text: (r.text as Record<string, string>)[lang], author: (r.name as Record<string, string>)[lang] }));
const reviewsPath = pagePath(lang, "reviews");

const icons: Record<string, string> = {"pencil": "M16.86 3.49a2.1 2.1 0 0 1 2.97 2.97L8.5 17.79 4 19l1.21-4.5L16.86 3.49Z M14.5 5.85l2.97 2.97", "check": "M20 7 9.5 17.5 4 12 M12 3a9 9 0 1 0 9 9", "people": "M16 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z M8 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z M2 20a6 6 0 0 1 12 0 M12 20a6 6 0 0 1 10 0", "phone": "M8 3h8a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Z M11 18h2", "compass": "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z M15.5 8.5 14 14l-5.5 1.5L10 10l5.5-1.5Z", "tag": "M3 12V4a1 1 0 0 1 1-1h8l9 9-9 9-9-9Z M7.5 7.5h.01"};
// Promise cards. Rating and the "every review" line come from the review
// export, so they stay true as new reviews arrive; no count is shown.
const allFive = reviewsData.reviews.length > 0 && reviewsData.reviews.every((r: any) => r.stars === 5);
const ratingValue = Number(reviewsData.ratingValue).toFixed(1).replace(".", lang === "pl" ? "," : ".");
const promises = [
  {
    value: `${ratingValue}`,
    title: allFive ? t("about.promise.1.title") : t("about.promise.1.titleAvg"),
    text: t("about.promise.1.text"),
  },
  { value: t("about.promise.2.value"), title: t("about.promise.2.title"), text: t("about.promise.2.text") },
  { value: "1", title: t("about.promise.3.title"), text: t("about.promise.3.text") },
  {
    value: `${settings.info.reply_hours} h`,
    title: t("about.promise.4.title").replace("{h}", settings.info.reply_hours),
    text: t("about.promise.4.text"),
  },
];

const values = ["phone","pencil","check","people","compass","tag"].map((icon, i) => ({
  icon: icons[icon],
  title: t(`about.values.${i + 1}.title`),
  text: t(`about.values.${i + 1}.text`),
}));

const gallery = [
  { src: teamBoth, alt: { pl: "Andrzej i Adam na łodzi w Delcie Mekongu", en: "Andrzej and Adam on a boat in the Mekong Delta" } },
  { src: teamBike, alt: { pl: "Andrzej i Adam na rowerach przy ruinach kościoła", en: "Andrzej and Adam cycling past church ruins" } },
  { src: teamDinner, alt: { pl: "Kolacja z lokalnymi gospodarzami", en: "Dinner with local hosts" } },
];
---


<section class="mt-16 lg:mt-24 overflow-hidden rounded-3xl bg-gray-950 text-white" aria-labelledby="promise-heading">
  <div class="grid lg:grid-cols-12">
    <div class="lg:col-span-5 p-8 sm:p-12 lg:p-14 flex flex-col justify-center">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-rose-400">{t("about.promise.eyebrow")}</p>
      <h2 id="promise-heading" class="mt-4 text-3xl sm:text-4xl lg:text-5xl font-semibold leading-tight">{t("about.promise.heading")}</h2>
      <p class="mt-6 text-lg leading-relaxed text-gray-300">{t("about.promise.lead")}</p>
      <div class="mt-8 flex items-center gap-4">
        <span class="h-0.5 w-12 bg-rose-600" aria-hidden="true"></span>
        <p class="text-sm text-gray-400">{t("about.promise.sign")}</p>
      </div>
    </div>
    <ul class="lg:col-span-7 grid sm:grid-cols-2 gap-px bg-white/10 border-t border-white/10 lg:border-t-0 lg:border-l">
      {
        promises.map((p) => (
          <li class="bg-gray-950 p-6 sm:p-10 flex gap-5 sm:block">
            <p class="w-20 shrink-0 sm:w-auto text-4xl sm:text-5xl font-semibold tracking-tight text-rose-500">{p.value}</p>
            <div>
              <h3 class="sm:mt-5 text-lg font-semibold leading-snug">{p.title}</h3>
              <p class="mt-2 text-base leading-relaxed text-gray-300">{p.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section class="mt-24 lg:mt-32" aria-labelledby="values-heading">
  <h2 id="values-heading" class="text-3xl font-semibold text-center">{t("about.values")}</h2>
  <p class="mt-3 text-center text-base text-gray-700 max-w-2xl mx-auto">{t("about.values.lead")}</p>
  <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      values.map((v) => (
        <li class="flex gap-4 bg-white border border-gray-200 rounded-xl p-6">
          <span class="shrink-0 w-11 h-11 rounded-full bg-rose-600/10 text-rose-600 inline-flex items-center justify-center" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="w-6 h-6 fill-none stroke-current stroke-[1.75]" stroke-linecap="round" stroke-linejoin="round"><path d={v.icon} /></svg>
          </span>
          <div>
            <h3 class="font-semibold text-lg leading-snug">{v.title}</h3>
            <p class="mt-1.5 text-base text-gray-700 leading-relaxed">{v.text}</p>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<section class="mt-24 lg:mt-32" aria-labelledby="team-heading">
  <h2 id="team-heading" class="text-3xl font-semibold text-center">
    {t("about.team")}
  </h2>
  <div class="mt-12 grid gap-12 lg:grid-cols-2 lg:gap-16">
    {
      team.map((member) => {
        const local = member.data[lang];
        return (
          <article class="flex flex-col sm:flex-row gap-6 lg:gap-8">
            <Image
              src={member.data.photo}
              alt={`${member.data.name}, ${member.data[lang].role}`}
              width={320}
              height={320}
              widths={[160, 320]}
              sizes="160px"
              quality={75}
              class="w-40 h-40 shrink-0 rounded-full object-cover shadow-lg"
            />
            <div class="flex flex-col gap-3">
              <div>
                <h3 class="text-2xl font-semibold">{member.data.name}</h3>
                <p class="text-rose-600 font-medium">{local.role}</p>
              </div>
              <p class="text-base leading-relaxed">{local.bio}</p>
              {local.facts.length > 0 && (
                <ul class="flex flex-wrap gap-2 text-sm">
                  {local.facts.map((fact) => (
                    <li class="rounded-full bg-gray-100 px-3 py-1">{fact}</li>
                  ))}
                </ul>
              )}
              {member.data.links.length > 0 && (
                <ul class="flex flex-wrap gap-4 text-sm font-medium">
                  {member.data.links.map((link) => (
                    <li>
                      <a
                        href={link.url}
                        target="_blank"
                        rel="noopener"
                        class="underline underline-offset-4 decoration-2 hover:text-rose-600"
                      >
                        {member.data.name.split(" ")[0]}: {link.label}
                        <span class="sr-only"> {t("footer.newTab")}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </article>
        );
      })
    }
  </div>
  <ul class="mt-12 grid grid-cols-3 gap-3">
    {
      gallery.map((g) => (
        <li class="overflow-hidden rounded-xl aspect-[4/3]">
          <Image src={g.src} alt={g.alt[lang]} width={800} widths={[400, 800]} sizes="(min-width: 1024px) 440px, 33vw" quality={70} class="w-full h-full object-cover" />
        </li>
      ))
    }
  </ul>
</section>

<section class="mt-24 lg:mt-32" aria-labelledby="reviews-heading">
  <h2 id="reviews-heading" class="text-3xl font-semibold text-center">
    {t("about.reviews")}
  </h2>
  <div class="mt-12 grid gap-8 md:grid-cols-2">
    {
      quotes.map((review) => (
        <blockquote class="bg-gray-100 rounded-xl p-8 flex flex-col gap-4">
          <p class="italic text-base leading-relaxed">“{review.text}”</p>
          {review.author && (
            <footer class="text-sm font-medium">{review.author}</footer>
          )}
        </blockquote>
      ))
    }
  </div>
  <p class="mt-8 text-center">
    <a
      href={reviewsPath}
      class="inline-block bg-rose-600 hover:bg-emerald-700 transition-colors px-4 py-2 rounded-lg text-white"
    >
      {t("reviews.count").replace("{n}", String(reviewsData.reviewCount))}: {t("nav.reviews").toLowerCase()}
    </a>
  </p>
</section>

<ContactDetails />
