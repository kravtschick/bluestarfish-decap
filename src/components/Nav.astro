---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { languages } from "../i18n/ui";
import { homePath, isActive, pagePath, type Lang, type PageKey } from "../i18n/routes";

interface Props {
  /** The current page in each language. Null when it has no counterpart. */
  alternates?: Record<string, string> | null;
}
const { alternates } = Astro.props;

const pathname = Astro.url.pathname;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
// The blog has no pages yet. Add "blog" back here once it does.
const items: PageKey[] = ["about", "countries", "trips", "contact"];
---

<ul class="xl:flex items-center gap-6 hidden">
  {
    items.map((key) => (
      <li>
        <a
          href={pagePath(lang, key)}
          class={`font-medium tracking-wide drop-shadow-sm ${
            isActive(pathname, pagePath(lang, key)) ? "text-rose-500" : ""
          }`}
        >
          {t(`nav.${key}`)}
        </a>
      </li>
    ))
  }
  {
    Object.entries(languages).map(([language, label]) => (
      <li class={language === lang ? "hidden" : "ml-16"}>
        <a
          href={alternates?.[language] ?? homePath(language as Lang)}
          hreflang={language}
          lang={language}
        >
          {label}
        </a>
      </li>
    ))
  }
</ul>
