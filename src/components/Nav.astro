---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { languages } from "../i18n/ui";
import { homePath, isActive, pagePath, type Lang, type PageKey } from "../i18n/routes";

interface Props {
  /** The current page in each language. Null when it has no counterpart. */
  alternates?: Record<string, string> | null;
}
const { alternates } = Astro.props;

const pathname = Astro.url.pathname;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
// The blog has no pages yet. Add "blog" back here once it does.
const items: PageKey[] = ["about", "countries", "trips", "reviews", "contact"];
---

<ul class="xl:flex items-center gap-8 hidden">
  {
    items.map((key) => (
      <li>
        <a
          href={pagePath(lang, key)}
          aria-current={isActive(pathname, pagePath(lang, key)) ? "page" : undefined}
          class={`py-2 text-[17px] font-semibold tracking-wide [text-shadow:0_1px_2px_rgb(0_0_0/0.35)] group-[.is-solid]:[text-shadow:none] underline-offset-8 decoration-2 hover:underline ${
            isActive(pathname, pagePath(lang, key)) ? "underline" : ""
          }`}
        >
          {t(`nav.${key}`)}
        </a>
      </li>
    ))
  }
  {
    Object.entries(languages).map(([language, label]) => (
      <li class={language === lang ? "hidden" : "ml-10"}>
        <a
          class="py-1.5 px-3 rounded-full border border-current font-semibold text-[15px] hover:bg-white/15"
          href={alternates?.[language] ?? homePath(language as Lang)}
          hreflang={language}
          lang={language}
        >
          {label}
        </a>
      </li>
    ))
  }
</ul>
