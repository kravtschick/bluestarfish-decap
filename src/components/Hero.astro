---
import { Image } from "astro:assets";
import Wrapper from "./Wrapper.astro";
import Chat from "./Chat.astro";
import chatImg from "../images/chat-white.svg";

interface Props {
  image: ImageMetadata;
  height: string;
  title: string;
  desc?: string;
  bottom: string;
  chat?: boolean;
}

const { image, height, title, desc, bottom, chat = false } = Astro.props;

// The hero is the largest element on every page, so it loads first and in a
// size that fits the screen. Never upscale beyond the source file.
const heroWidth = Math.min(image.width, 2000);
const heroWidths = [640, 828, 1080, 1600, 2000].filter((w) => w < heroWidth).concat(heroWidth);
---

<div class={`relative mx-auto ${height}`}>
  <Image
    src={image}
    alt={title.trim()}
    width={heroWidth}
    widths={heroWidths}
    sizes="100vw"
    quality={50}
    loading="eager"
    fetchpriority="high"
    decoding="async"
    class={`object-cover w-full brightness-90 ${height}`}
  />

  <div class={`absolute inset-x-0 ${bottom}`}>
    <Wrapper>
      <div
        class="flex flex-col gap-8 text-white text-center w-full max-w-4xl mb-8 mx-auto mt-24 sm:mt-0"
      >
        <h1
          class="font-semibold drop-shadow-xl text-3xl md:text-4xl lg:text-5xl leading-normal md:leading-normal lg:leading-normal"
        >
          {title}
        </h1>
        {
          desc && (
            <p class="text-xl md:text-xl lg:text-2xl drop-shadow-xl">{desc}</p>
          )
        }
        {chat && <Chat image={chatImg.src} classes="w-56" margin="mt-8" />}
      </div>
    </Wrapper>
  </div>
</div>
