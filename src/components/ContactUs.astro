---
interface Props {
  textEn?: string;
  textPl?: string;
}

import { getLangFromUrl } from "../i18n/utils";
import { pagePath } from "../i18n/routes";
const lang = getLangFromUrl(Astro.url);

const { textPl, textEn } = Astro.props;
---

<div
  class="flex flex-col gap-8 items-center mt-24 lg:mt-32 border-t-[1px] border-gray-200 pt-16"
>
  <div class="text-xl text-center">{lang === "en" ? textEn : textPl}</div><a
    href={pagePath(lang, "contact")}
    class="bg-rose-600 hover:bg-emerald-700 transition-colors px-4 py-2 rounded-lg text-white"
    >{lang === "en" ? "Write to Us" : "Napisz do nas"}</a
  >
</div>
