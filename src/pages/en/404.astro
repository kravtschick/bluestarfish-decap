---
import Hero from "../../components/Hero.astro";
import Wrapper from "../../components/Wrapper.astro";
import Layout from "../../layouts/Layout.astro";
import image from "../../assets/images/404.jpg";
import question from "../../../public/question.svg";
import { Image } from "astro:assets";
import { homePath } from "../../i18n/routes";
---

<Layout title="Page not found (404)" description="We could not find a page at this address." noindex>
  <main class="mb-16">
    <Hero
      image={image}
      height="h-[300px] md:h-[550px]"
      bottom="bottom-6"
      title="404"
    />
    <Wrapper>
      <div class="mt-24 lg:mt-32 text-center items-center flex flex-col gap-8">
        <h2 class="text-3xl font-semibold">Page not found</h2>
        <div><Image src={question} alt="" class="w-24" /></div>
        <p>
          We could not find a page at this address. Check that the address is
          typed correctly, or go back to the home page:
        </p>
        <a
          href={homePath("en")}
          class="py-2 px-4 rounded bg-rose-500 hover:bg-emerald-500 text-white"
          >Home page</a
        >
      </div>
    </Wrapper>
  </main>
</Layout>
