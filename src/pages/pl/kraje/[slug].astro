---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import Hero from "../../../components/Hero.astro";
import Wrapper from "../../../components/Wrapper.astro";
import { useTranslations } from "../../../i18n/utils";
import { pagePath } from "../../../i18n/routes";
import TripPlannerForm from "../../../components/TripPlannerForm.astro";

export async function getStaticPaths() {
  const allCountries = await getCollection("country", ({ id }) => {
    return id.startsWith("pl/");
  });

  const paths = allCountries.map((country) => {
    const [lang, ...slug] = country.slug.split("/");
    return {
      params: { lang, slug: slug.join("/") || undefined },
      props: country,
    };
  });

  return paths;
}
const country = Astro.props;
const { Content } = await country.render();
const t = useTranslations("pl") as (k: string) => string;
const updated = country.data.updated
  ? country.data.updated.toLocaleDateString("pl-PL", { year: "numeric", month: "long" })
  : null;
---

<Layout
  title={country.data.seo.seoTitle}
  description={country.data.seo.seoDesc}
  name={country.data.title}
  image={country.data.cover}
>
  <main>
    <Hero
      image={country.data.cover}
      height="h-[300px] md:h-[550px]"
      bottom="bottom-1/2 translate-y-1/2"
      title={country.data.h1 ?? country.data.title}
      chat={false}
    />
    <Wrapper>
      {
        country.body && (
          <div class="mt-24 lg:mt-32 prose-lg prose-headings:font-semibold mx-auto w-full md:max-w-2xl lg:max-w-3xl xl:max-w-5xl">
            <Content />
            <p class="not-prose mt-12 pt-6 border-t border-gray-200 text-sm text-gray-600">
              {t("country.byline")}
              {updated && <> {t("country.updated").replace("{date}", updated)}</>}{" "}
              <a href={pagePath("pl", "about")} class="underline">{t("country.bylineLink")}</a>
            </p>
          </div>
        )
      }
      <TripPlannerForm destination={country.data.title} />
    </Wrapper>
  </main>
</Layout>
