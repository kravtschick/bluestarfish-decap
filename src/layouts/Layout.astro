---
import { ViewTransitions } from "astro:transitions";
import { fade } from "astro:transitions";
import { getImage } from "astro:assets";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import settings from "../data/settings.json";
import reviewsData from "../data/reviews.json";
import defaultShareImage from "../assets/images/home-hero.jpg";
import "@fontsource/poppins/400.css";
import "@fontsource/poppins/500.css";
import "@fontsource/poppins/600.css";
import poppins400 from "@fontsource/poppins/files/poppins-latin-400-normal.woff2?url";
import poppins600 from "@fontsource/poppins/files/poppins-latin-600-normal.woff2?url";
import "../styles/app.css";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { getAlternates } from "../i18n/alternates";
import { homePath, pageKeyOf, pagePath, segmentsOf } from "../i18n/routes";

interface Props {
  title: string;
  description: string;
  /** Short name of the page for breadcrumbs. Falls back to `title`. */
  name?: string;
  /** Image used when the page is shared. Falls back to the home hero. */
  image?: ImageMetadata;
  /** Keeps the page out of search results (404 pages). */
  noindex?: boolean;
}

const { title, description, name, image, noindex = false } = Astro.props;

// Set PUBLIC_SITE_ENV=staging when building the staging copy: it is kept out
// of search results, Google Analytics and the CMS login.
const isStaging = import.meta.env.PUBLIC_SITE_ENV === "staging";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const site = Astro.site!;
const pathname = Astro.url.pathname;
const abs = (path: string) => new URL(path, site).href;

// Full <title>: keep the long brand name only when the result still fits.
const longTitle = `${title} | ${settings.site_title}`;
const fullTitle = longTitle.length <= 60 ? longTitle : `${title} | Blue Starfish`;

const canonical = abs(pathname);
const alternates = noindex ? null : await getAlternates(pathname);

const shareImage = await getImage({
  src: image ?? defaultShareImage,
  width: 1200,
  format: "jpg",
  quality: 75,
});

// Structured data
const organization = {
  "@type": "TravelAgency",
  "@id": abs("/#organization"),
  name: settings.site_title,
  legalName: settings.info.name.trim(),
  url: abs("/"),
  logo: abs("/logo.svg"),
  image: abs(shareImage.src),
  telephone: settings.info.phone.replace(/\s+/g, ""),
  email: settings.info.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: settings.info.address,
    addressLocality: "Ho Chi Minh City",
    addressCountry: "VN",
  },
  areaServed: ["VN", "KH", "LA"],
  availableLanguage: ["en", "pl"],
  ...(settings.info.google_business ? { hasMap: settings.info.google_business } : {}),
  sameAs: [
    settings.info.google_business,
    ...Object.values(settings.social as Record<string, string>),
  ].filter(Boolean),
  ...(settings.info.tax_id ? { taxID: settings.info.tax_id } : {}),
  ...(settings.info.founded ? { foundingDate: settings.info.founded } : {}),
  founder: [
    { "@type": "Person", name: "Adam Krawczyk", url: abs(pagePath(lang, "about")) },
    { "@type": "Person", name: "Andrzej Białasiewicz", url: abs(pagePath(lang, "about")) },
  ],
};

const isHome = segmentsOf(pathname).length === 1;
const isReviews = pageKeyOf(pathname) === "reviews";
const pageKey = pageKeyOf(pathname);
const isCountry = pageKey === "countries" && segmentsOf(pathname).length === 3;

const crumbs: { name: string; url: string }[] = [];
if (!isHome && !noindex && pageKey) {
  crumbs.push({ name: lang === "pl" ? "Strona główna" : "Home", url: abs(homePath(lang)) });
  if (isCountry) {
    crumbs.push({ name: t("nav.countries"), url: abs(pagePath(lang, "countries")) });
  }
  crumbs.push({ name: name ?? title, url: canonical });
}

const graph: Record<string, unknown>[] = [];
if (isHome) graph.push(organization);
if (isReviews) {
  // Review markup only on the page that shows the reviews themselves.
  graph.push({
    ...organization,
    aggregateRating: {
      "@type": "AggregateRating",
      ratingValue: reviewsData.ratingValue,
      reviewCount: reviewsData.reviewCount,
      bestRating: 5,
    },
    review: reviewsData.reviews.slice(0, 10).map((r) => ({
      "@type": "Review",
      author: { "@type": "Person", name: (r.name as Record<string, string>)[lang] },
      datePublished: r.date,
      reviewRating: { "@type": "Rating", ratingValue: r.stars, bestRating: 5 },
      reviewBody: (r.text as Record<string, string>)[r.lang],
      inLanguage: r.lang,
    })),
  });
}
if (crumbs.length) {
  graph.push({
    "@type": "BreadcrumbList",
    itemListElement: crumbs.map((crumb, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: crumb.name,
      item: crumb.url,
    })),
  });
}
const jsonLd = graph.length
  ? JSON.stringify({ "@context": "https://schema.org", "@graph": graph })
  : null;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={poppins600} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={poppins400} as="font" type="font/woff2" crossorigin />
    {
      !isStaging && (
        <script is:inline>
          // Google Analytics. The tag library (about 200 KB) loads after the
          // first scroll, tap or key press, or 3.5 s after the page has
          // loaded, so it does not compete with the first render. Events sent
          // before that are queued in dataLayer and delivered when it loads.
          // The guard keeps view-transition navigations from adding listeners twice.
          (function () {
            if (window.__bsAnalytics) return;
            window.__bsAnalytics = true;
            window.dataLayer = window.dataLayer || [];
            window.gtag = function () {
              dataLayer.push(arguments);
            };
            gtag("js", new Date());
            gtag("config", "G-10NKTL5XZN");

            var loaded = false;
            var triggers = ["scroll", "pointerdown", "keydown", "touchstart"];
            function load() {
              if (loaded) return;
              loaded = true;
              triggers.forEach(function (name) {
                removeEventListener(name, load);
              });
              var script = document.createElement("script");
              script.async = true;
              script.src = "https://www.googletagmanager.com/gtag/js?id=G-10NKTL5XZN";
              document.head.appendChild(script);
            }
            triggers.forEach(function (name) {
              addEventListener(name, load, { once: true, passive: true });
            });
            addEventListener("load", function () {
              setTimeout(load, 3500);
            });

            // Count enquiries: clicks on WhatsApp, email and phone links.
            document.addEventListener("click", function (event) {
              var link = event.target.closest && event.target.closest("a[href]");
              if (!link) return;
              var href = link.getAttribute("href") || "";
              var method = href.indexOf("wa.me") > -1
                ? "whatsapp"
                : href.indexOf("mailto:") === 0
                  ? "email"
                  : href.indexOf("tel:") === 0
                    ? "phone"
                    : null;
              if (method) {
                gtag("event", "generate_lead", {
                  method: method,
                  page_path: location.pathname,
                });
              }
            });
          })();
        </script>
      )
    }
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {(noindex || isStaging) && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {
      alternates &&
        Object.entries(alternates).map(([code, path]) => (
          <link rel="alternate" hreflang={code} href={abs(path)} />
        ))
    }
    {
      alternates && (
        <link rel="alternate" hreflang="x-default" href={abs(alternates.en)} />
      )
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={settings.site_title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={abs(shareImage.src)} />
    <meta property="og:locale" content={lang === "pl" ? "pl_PL" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    {
      !isStaging && (
        <script is:inline>
          // Netlify Identity is only needed when someone opens a CMS invite,
          // password-reset or confirmation link. Load it only then.
          (function () {
            if (!/(invite|recovery|confirmation|email_change)_token=|access_token=/.test(location.hash)) return;
            var script = document.createElement("script");
            script.src = "https://identity.netlify.com/v1/netlify-identity-widget.js";
            script.onload = function () {
              window.netlifyIdentity.on("init", function (user) {
                if (!user) {
                  window.netlifyIdentity.on("login", function () {
                    location.href = "/admin/";
                  });
                }
              });
            };
            document.head.appendChild(script);
          })();
        </script>
      )
    }
    <ViewTransitions />
  </head>

  <body class="subpixel-antialiased bg-white text-gray-950 font-normal text-lg">
    <div class="grid grid-flow-row auto-rows-[auto_1fr_auto] h-screen">
      <Header alternates={alternates} />
      <div transition:animate={fade({ duration: "0.5s" })}><slot /></div>
      <Footer />
    </div>
    <style is:global>
      body {
        font-family: "Poppins", sans-serif;
      }
    </style>
  </body>
</html>
